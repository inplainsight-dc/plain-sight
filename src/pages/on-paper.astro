---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// p6-t4 of the DC Short-Term Rentals research node — the accountability view.
// The charter calls this the view most likely to be attacked, so it ships last
// of the Phase 6 set and only after the Phase 2 record match, which means its
// claims rest on matched register records rather than text a host typed.
//
// The panel markup is generated by the research node
// (scripts/build_accountability_view.py -> on-paper-body.html) because
// that is where small-cell suppression happens, at BUILD time. Suppressing in a
// renderer ships the real number and calls it hidden — that was Wave 2 R1.
//
// Unlike /ghost-homes, the payload is INLINED in the partial rather than fetched
// from a JSON file. Ghost Homes shipped a fingerprinted script that met a
// separately-cached data.json and threw a TypeError, taking out the whole front
// door for returning readers (17 Aug 2026). Inlining makes code and data a
// single artifact, so they cannot version apart.
//
// CSS is scoped under #lm inside the partial, so it cannot leak into the site.
//
// NOT in sitemap.xml yet, deliberately — same convention as /almanac. It goes in
// once the ported page has been through a wave in this form.
import body from '../on-paper-body.html?raw';

const today = new Date().toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric',
});
---
<Base
  title="DC On Paper"
  description="Whole homes rented out as full-time short-term rentals in DC, sorted by what the public licensing register says about the license each one displays. A population to audit, not a determination about any listing.">
  <Header slot="header" />

  <section class="ips-lead">
    <div class="ps-container">
      <p class="ps-record ps-record--red ips-dateline">{today.toUpperCase()} &nbsp;|&nbsp; WASHINGTON, DC</p>
      <p class="ips-back"><a href="/">&larr; Back to In Plain Sight</a> &nbsp;&middot;&nbsp; <a href="/ghost-homes">DC Ghost Homes</a> &nbsp;&middot;&nbsp; <a href="/short-term-rental-rules">The rules</a></p>
      <div class="ips-lead__grid">
        <div class="ips-lead__main">
          <h1 class="ips-lead__h">On <span class="ps-highlight">paper</span>.</h1>
          <p class="ips-lead__blurb">What a listing claims on paper, against what the District’s licensing register actually holds — for every whole home rented out as a full-time short-term rental.</p>
        </div>
        <aside class="ips-lead__rail">
          <div class="lm-rail">
            <p class="lm-rail__h ps-record">What this is</p>
            <p class="lm-rail__n">A population to audit.</p>
            <p class="lm-rail__note">Not a determination that any listing is unlawful, and no individual host is named. Every category here has lawful explanations, and they are all written down.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="ips-sec">
    <div class="ps-container">
      <div set:html={body} />
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  /* Layout classes shared with the other tool pages; carried in-page as all the
     existing pages do. Promoting the ips-* set to global.css is a follow-up. */
  .ips-lead { padding-block: clamp(2.6rem, 8vw, 5rem) clamp(2rem, 5vw, 3.4rem); }
  .ips-lead__blurb { color: var(--ps-ink-soft); font-size: 1.15rem; max-width: 46ch; }
  .ips-lead__rail { border-left: 2px solid var(--ps-ink); padding-left: 1.2rem; }
  .ips-back { margin: 0 0 0.75rem; font-size: 0.85rem; }
  .ips-sec { padding-block: clamp(1.4rem, 3vw, 2rem); }

  .lm-rail__h { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ps-ink-soft); margin: 0 0 0.3rem; }
  .lm-rail__n { font-family: var(--ps-font-display); font-weight: 700; font-size: 1.6rem; line-height: 1.1; margin: 0 0 0.5rem; }
  .lm-rail__note { color: var(--ps-ink-soft); font-size: 0.95rem; margin: 0; }

  @media (max-width: 640px) {
    .ips-lead__rail { border-left: 0; border-top: 2px solid var(--ps-ink); padding-left: 0; padding-top: 1rem; }
  }
</style>
