<!-- Freshness. The page is static and its figures are frozen at the capture, so the one
     honest dynamic element is how old that capture is. Server-rendered content already
     states the date; this only adds the age, and shouts if the capture has gone stale. -->
<script define:vars={{ captured: D.captured, staleAfter: D.stale_after_days, capturedLong }} is:inline>
  (function () {
    var el = document.getElementById('freshness');
    if (!el) return;
    var now = new Date();
    var today = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
    var age = Math.round((today - Date.parse(captured + 'T00:00:00Z')) / 86400000);
    if (!isFinite(age) || age < 0) return; // clock skew — leave the server text alone
    var when = age === 0 ? 'today' : age === 1 ? 'yesterday' : age + ' days ago';

    if (age > staleAfter) {
      el.className = 'aw-fresh aw-fresh--stale';
      el.innerHTML =
        '<b>This page may be out of date.</b> Its figures come from a capture taken ' + when +
        ' (' + capturedLong + '), and the register it reads changes daily. Seats listed as past ' +
        'their term may since have been filled, and others may have crossed the cap. Treat every ' +
        'figure below as evidence about ' + capturedLong + ', not as current state.';
    } else {
      el.innerHTML =
        'Figures from the capture taken <b>' + capturedLong + '</b> (' + when + '). Every ' +
        'duration is measured against the capture date, not today’s date.';
    }
  })();

  // Copy button for the citation (decision D2). Created here rather than in the markup so a
  // reader without JavaScript sees selectable text and no button, instead of a dead control.
  (function () {
    var cite = document.getElementById('citation');
    if (!cite || !navigator.clipboard) return;
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'aw-citebtn';
    btn.textContent = 'Copy citation';
    btn.addEventListener('click', function () {
      navigator.clipboard.writeText(cite.textContent.trim()).then(function () {
        btn.textContent = 'Copied';
        setTimeout(function () { btn.textContent = 'Copy citation'; }, 2000);
      });
    });
    cite.parentNode.insertBefore(btn, cite.nextSibling);
  })();
</script>

