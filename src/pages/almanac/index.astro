  .al-feedback__btn:hover { background: var(--ps-ink); color: var(--ps-paper); }

  @media (max-width: 640px) {
    .ips-lead__rail { border-left: 0; border-top: 2px solid var(--ps-ink); padding-left: 0; padding-top: 1.2rem; }
    .al-level { grid-template-columns: 1fr; gap: 0.2rem; }
  }

  /* ---- p2-t2: your election, in plain sight -------------------------------- */
  .al-h3 { font-family: var(--ps-font-display); font-weight: 700; font-size: 1.25rem; margin: 2rem 0 0.35rem; }
  .al-sub { color: var(--ps-ink-soft); max-width: 62ch; margin-bottom: 1rem; }

  /* The next election */
  .al-next { border: 1px solid var(--ps-line); border-left: 3px solid var(--ps-accent); border-radius: 0 8px 8px 0; background: var(--ps-surface-2); padding: 1.1rem 1.35rem; max-width: 62ch; }
  .al-next__kicker { display: block; color: var(--ps-accent-text); margin-bottom: 0.2rem; }
  .al-next__h { font-family: var(--ps-font-display); font-weight: 700; font-size: clamp(1.4rem, 3.4vw, 1.9rem); }
  .al-next__date { font-size: 1.15rem; color: var(--ps-ink); margin-top: 0.15rem; }
  .al-next__countdown { display: block; color: var(--ps-accent-text); margin-top: 0.25rem; }
  .al-next__countdown.is-past { color: var(--ps-ink-soft); }
  .al-next__sum { color: var(--ps-ink-soft); margin-top: 0.7rem; }

  /* The dates inside the date */
  .al-windows { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ps-ink); max-width: 72ch; }
  .al-window { display: grid; grid-template-columns: 15rem 1fr; gap: 1rem; padding: 0.9rem 0.2rem; border-bottom: 1px solid var(--ps-line); }
  .al-window__kind { display: block; color: var(--ps-accent-text); font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .al-window__dates { display: block; font-family: var(--ps-font-record); font-size: 0.95rem; color: var(--ps-ink); }
  .al-window__label { font-weight: 600; margin-bottom: 0.2rem; }
  .al-window__note { color: var(--ps-ink-soft); font-size: 0.99rem; }

  /* .ps-record is a LABEL style — 0.72rem, uppercase, wide tracking. It belongs on
     'CLOSES', 'MATCHED', '§ 03'. It was on these too until an audit found 197
     characters of uppercase 11.5px prose and 130 opening times shouting their
     dates; all-caps is harder to read and worse for dyslexic readers, and
     uppercasing a cited document title misquotes it. Data keeps the record
     typeface, at a readable size and in its own case. */
  .al-source { display: block; margin-top: 1rem; color: var(--ps-ink-soft); max-width: 72ch; line-height: 1.5; font-size: 0.88rem; }
  .al-source a { color: var(--ps-ink); }
  .al-caution { margin-top: 0.9rem; max-width: 68ch; border-left: 3px solid var(--ps-caution); background: color-mix(in srgb, var(--ps-caution) 8%, transparent); padding: 0.7rem 0.95rem; border-radius: 0 6px 6px 0; color: var(--ps-ink); }

