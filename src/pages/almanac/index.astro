  .al-avenue__title { font-family: var(--ps-font-display); font-weight: 700; font-size: 1.3rem; }
  .al-tag { font-size: 0.68rem; letter-spacing: 0.04em; text-transform: uppercase; padding: 0.12rem 0.5rem; border-radius: 999px; border: 1px solid var(--ps-line); color: var(--ps-ink-soft); white-space: nowrap; }
  .al-tag[data-d="native"] { border-color: var(--ps-accent); color: var(--ps-accent-text); }
