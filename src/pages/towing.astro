---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import duties from '../data/towing/duties.json';

// -----------------------------------------------------------------------------
// SOURCE OF TRUTH.  Nothing on this page states the law from memory.
// src/data/towing/duties.json is a projection, written by
// scripts/sync-towing-data.mjs from ../DC Towing/data/towing-duties.json, which
// is itself generated by that project's scripts/build_duties.py directly from
// 16 DCMR chapter 4. Every duty is bound to a verbatim anchor in the cited
// section, so an amendment breaks the build instead of quietly misstating the
// law here. To change a duty, change the regulation reading in the node.
//
// THE CPPA FIGURE IS DELIBERATELY CONSERVATIVE (node roadmap p1-t4, resolved).
// D.C. Code § 28-3905(k)(2)(A)(i) — note (k)(2), not (k)(1), which is only about
// WHO may sue — gives treble damages or $1,500 per violation, whichever is
// greater. B26-0174 raises the floor to $3,000 and renumbers the remedies to
// § 28-3905(m)(2)(A), but it is enrolled, awaiting congressional review, and its
// private-action provisions hang on an FY2027 budget applicability clause. The
// vendored D.C. Code mirror is the 2026-05-23 series and cannot see past it.
// So the page says "at least $1,500", which is true now AND stays true if the
// increase has landed. Printing $3,000 and being wrong would tell someone their
// claim is worth double what it is. Understate; never overstate.
// -----------------------------------------------------------------------------

const today = new Date().toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric',
});

const GROUP_TITLES = {
  'towed-from-private-property': 'If it was towed from a lot without your say-so',
  'any-tow': 'What any tow company owes you',
  'the-truck': 'The truck itself',
  'accident-scene': 'At a crash',
  'licensing': 'Licensing',
};

const byGroup = duties.groupOrder.map((g) => ({
  id: g,
  title: GROUP_TITLES[g] ?? g,
  items: duties.duties.filter((d) => d.group === g),
}));

const publicTowDef = duties.definitions.find((d) => d.term === 'Public tow');

// The two questions the whole page turns on. `key` names the radio group.
const ANSWERS = [
  { v: 'yes', label: 'Yes' },
  { v: 'no', label: 'No' },
  { v: 'unk', label: 'I don\u2019t know' },
];

const tests = [
  {
    n: '01',
    key: 'ticket',
    q: 'Was there a ticket?',
    body: 'A car cannot be towed off private property without your consent unless a police officer or a parking enforcement official issued it a citation — or a police officer directed the tow in an emergency.',
    edge: 'A landlord, a property manager, or the owner of the lot cannot authorize it on their own.',
    cite: '16 DCMR § 406.7',
  },
  {
    n: '02',
    key: 'control',
    q: 'Is there a control number?',
    body: 'The company had to get a towing control number from DPW before the tow — and the storage lot has to give you that number when they release the car, along with the legal authority for the removal.',
    edge: 'Even in an emergency they still have to obtain one within two hours.',
    cite: '16 DCMR §§ 406.3, 408.9',
  },
];

const caps = [
  ['Standard tow', 'a car at or under 8,000 lb, towed within the District', '$100'],
  ['Storage', 'per 24 hours, or any part of one', '$20'],
  ['Drop fee', 'if you arrive and they stop the tow before removing the car', '$50'],
];

// Retrieval differs completely depending on who took the car, and the reader
// cannot act until they know which. District tows go to a DPW lot and are
// gated on unpaid tickets; private-lot tows go to the company's own storage
// lot and are governed by the duties above. Fees below are DC DMV's published
// figures, which match 16 DCMR § 408.1.
const districtLot = [
  ['Where it goes', 'Blue Plains, 5001 Shepherd Parkway SW — or Bryant Street, 2115 Bryant St NE. Call first; don’t guess.'],
  ['What to bring', 'Your fee payment receipt, the vehicle registration, and a valid driver’s license. Collecting someone else’s car? You need a notarized statement from the owner.'],
  ['How you pay', 'Card only — Visa or MasterCard. Cash and checks are not accepted.'],
  ['Hours', 'Monday to Friday, 8:30am to 4:30pm, except District holidays.'],
  ['The catch', 'Every outstanding ticket has to be paid first — including tickets on other plates registered to you. And once you’ve paid the storage, collect the car that day or another day’s storage is added.'],
];

const districtFees = [
  ['Tow', '$100'],
  ['Tow, oversized vehicle', '$275'],
  ['Storage, per day', '$20'],
  ['Boot removal', '$75'],
];

const privateLot = [
  ['They must tell you where it is', 'The storage lot address is required on the itemized estimate, and the lot must be in the District.', '16 DCMR §§ 409.2, 405.1'],
  ['They must release it promptly', 'On proof of who you are and that it’s your car, plus payment of what’s genuinely owed — unless the government has placed a hold on it.', '16 DCMR § 408.7'],
  ['They must take a card', 'Cash, insurance draft, certified check, bank check, money order, and at least two major credit cards. Cash-only is a violation.', '16 DCMR § 408.8'],
  ['You can inspect it before paying', 'Refusing you that is a violation in itself.', '16 DCMR § 410.13'],
  ['They must hand you five things', 'The towing control number, the legal authority for the removal, an itemized statement, a receipt, and a copy of the Owner’s Bill of Rights.', '16 DCMR § 408.9'],
];

const routes = [
  {
    who: 'DLCP — Department of Licensing and Consumer Protection',
    what: 'The regulator. It is obliged to investigate a complaint, and it can suspend or revoke the license of a towing business or a storage lot.',
    how: 'dlcp@dc.gov · (202) 671-4500 · the Consumer Protection Unit complaint form',
    cite: '16 DCMR §§ 411.2, 411.4',
  },
  {
    who: 'Check the license first — SCOUT',
    what: 'Every towing business, storage lot and truck in the District has to be licensed. SCOUT will tell you whether this one is. Operating without a license can carry arrest, not just a fine.',
    how: 'scout.dlcp.dc.gov',
    cite: '16 DCMR §§ 402.1, 410.1, 411.8',
  },
  {
    who: 'The Office of the Attorney General',
    what: 'OAG enforces the Consumer Protection Procedures Act and can sue a company for restitution and penalties.',
    how: 'oag.dc.gov — consumer complaint',
    cite: 'D.C. Code §§ 28-3901–3913',
  },
  {
    who: 'You, directly',
    what: 'The CPPA lets you sue directly, and recover treble damages or at least $1,500 per violation — whichever is greater — plus your attorney’s fees, punitive damages and an injunction. The regulation above puts more than twenty separate duties on the company, and each breach is a violation. Small claims in D.C. Superior Court is a realistic venue.',
    how: 'A consumer lawyer, or the Superior Court Small Claims and Conciliation Branch',
    cite: 'D.C. Code § 28-3905(k)(2)',
  },
];
---

<Base
  title="Towed in DC? Find your car, and find out if it was legal"
  description="Your car is gone in Washington DC. Call (202) 541-6083 to find out where it is. Then: a tow you did not agree to is a public tow, which means it needed a citation and a DPW control number, and it is capped at $100 plus $20 a day. What the tow company or the District owes you under 16 DCMR chapter 4, how to get the car back, and who to complain to. No account, no AI, nothing leaves your browser."
>
  <Header slot="header" />

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="ips-star" viewBox="0 0 24 24"><polygon points="12,1 14.5,8.5 22,8.5 16,13 18,21 12,16.5 6,21 8,13 2,8.5 9.5,8.5"/></symbol>
  </svg>

  <!-- LEAD -->
  <section class="ips-lead">
    <div class="ps-container">
      <p class="ps-record ps-record--red ips-dateline">{today.toUpperCase()} &nbsp;|&nbsp; AFTER A TOW</p>
      <div class="ips-lead__grid">
        <div class="ips-lead__main">
          <h1 class="ips-lead__h">Your car is <span class="ps-highlight">gone</span>. Two questions.</h1>
          <p class="ips-lead__blurb">
            Whoever took it — the District, or a private lot — <strong>you did not consent to it, and the
            District calls that a public tow.</strong> Public tows come with rules that had to be followed
            <em>before</em> the truck arrived, a published ceiling on what you can be charged, and things
            they owe you when you turn up to collect. Most people are never told any of it, and pay
            whatever they’re asked.
          </p>
          <p class="ips-lead__note ps-record">
            16 DCMR chapter 4 &middot; not legal advice &middot; this page states the rule, not the merits of your tow
          </p>
        </div>
        <aside class="ips-lead__rail">
          <div class="tw-stub" aria-hidden="true">
            <span class="tw-stub__bars"></span>
            <p class="tw-stub__h">Public tow</p>
            <p class="tw-stub__sub">16 DCMR &sect; 408.1 &middot; maximum</p>
            <dl class="tw-stub__lines">
              <div class="tw-stub__line"><dt>Tow</dt><dd>100.00</dd></div>
              <div class="tw-stub__line"><dt>Storage / day</dt><dd>20.00</dd></div>
              <div class="tw-stub__line"><dt>Drop fee</dt><dd>50.00</dd></div>
            </dl>
            <p class="tw-stub__ask">Anything else on it?</p>
            <p class="tw-stub__ans">Ask why.</p>
          </div>
          <p class="rk-privacy ps-record">
            No account. No AI. Nothing you read here leaves your browser. Every duty below is generated
            straight from the regulation — see the method note at the end.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- §01 FIND IT FIRST -->
  <section class="ips-sec" id="find-it">
    <div class="ps-container">
      <div class="ips-sec-head">
        <span class="ps-record ps-record--red">&sect; 01</span>
        <h2 class="ips-sec-title">Find it first</h2>
        <span class="ips-sec-rule"></span>
      </div>

      <p class="ips-lede">
        Before anything else — <strong>is it towed, or is it stolen?</strong> Most people can’t tell,
        and the answer changes what you do next. There is one number that settles it.
      </p>

      <div class="tw-call">
        <p class="ps-record tw-call__label">Towing Control Dispatch Center</p>
        <p class="tw-call__num"><a href="tel:+12025416083">(202) 541-6083</a></p>
        <p class="tw-call__note">
          They can tell you whether your car was towed and which lot it went to. If they have no
          record of it, treat it as stolen and report it to the police.
        </p>
      </div>

      <p class="tw-note">
        If the District towed it, the government is also supposed to notify the registered owner of
        the tow and where the car is. <span class="tw-cite ps-record">16 DCMR &sect; 406.10</span>
      </p>
    </div>
  </section>

  <!-- §01 THE TWO QUESTIONS -->
  <section class="ips-sec" id="two-questions">
    <div class="ps-container">
      <div class="ips-sec-head">
        <span class="ps-record ps-record--red">&sect; 02</span>
        <h2 class="ips-sec-title">Ask these two things</h2>
        <span class="ips-sec-rule"></span>
      </div>

      <p class="tw-def">
        <span class="ps-record ps-record--red tw-def__label">The definition it all turns on</span>
        A <strong>private tow</strong> is one you asked for. A <strong>public tow</strong> is one you didn’t —
        and the regulation says so in as many words, listing
        <span class="ps-mark-und">tows from private real property</span> among them.
        That single line is why the rules below apply to a tow out of your own apartment lot.
        <span class="tw-cite ps-record">{publicTowDef?.citation ?? '16 DCMR § 499'}</span>
      </p>

      <ol class="tw-tests">
        {tests.map((t) => (
          <li class="tw-test">
            <p class="tw-test__n ps-record ps-record--red">{t.n}</p>
            <div class="tw-test__body">
              <h3 class="tw-test__q">{t.q}</h3>
              <p class="tw-test__text">{t.body}</p>
              <p class="tw-test__edge"><strong>{t.edge}</strong></p>
              <fieldset class="tw-ask">
                <legend class="ps-record tw-ask__legend">Your answer</legend>
                <div class="tw-ask__opts">
                  {ANSWERS.map((a) => (
                    <span class="tw-ask__opt">
                      <input class="tw-ask__in" type="radio" data-q={t.key}
                             id={`tw-${t.key}-${a.v}`} name={`tw-${t.key}`} value={a.v} />
                      <label class="tw-ask__lab" for={`tw-${t.key}-${a.v}`}>{a.label}</label>
                    </span>
                  ))}
                </div>
              </fieldset>
              <p class="tw-cite ps-record">{t.cite}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="tw-stand" id="twStand" role="status" aria-live="polite">
        <p class="ps-record tw-stand__label">Where you stand</p>
        <p class="tw-stand__verdict" id="twVerdict">
          Answer both and your position appears here. Nothing you tap leaves this page.
        </p>
        <p class="tw-stand__detail" id="twDetail"></p>
      </div>

      <p class="tw-note">
        This tells you what the regulation required of them. <strong>It does not rule on your tow</strong> —
        only DLCP, or a court, can do that.
      </p>
    </div>
  </section>

  <!-- §02 WHAT IT CAN COST -->
  <section class="ips-sec" id="what-it-costs">
    <div class="ps-container">
      <div class="ips-sec-head">
        <span class="ps-record ps-record--red">&sect; 03</span>
        <h2 class="ips-sec-title">What it can cost</h2>
        <span class="ips-sec-rule"></span>
      </div>

      <p class="ips-lede">
        Because it’s a public tow, the District’s own published schedule sets the ceiling — not the rates
        the company advertises, and not the rates painted on the truck. Those govern tows you
        <em>request</em>.
      </p>

      <table class="tw-caps">
        <caption class="ps-record">Maximum public-tow charges &middot; 16 DCMR &sect; 408.1</caption>
        <thead>
          <tr><th scope="col">Charge</th><th scope="col">What it covers</th><th scope="col" class="tw-caps__num">Cap</th></tr>
        </thead>
        <tbody>
          {caps.map(([name, what, amount]) => (
            <tr>
              <th scope="row">{name}</th>
              <td>{what}</td>
              <td class="tw-caps__num"><strong>{amount}</strong></td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="tw-rc">
        <p class="ps-record tw-rc__label">Check it against your receipt</p>
        <div class="tw-rc__row">
          <p class="tw-rc__field">
            <label for="twCharged">What they charged you</label>
            <span class="tw-rc__money">
              <span class="tw-rc__cur" aria-hidden="true">$</span>
              <input type="number" id="twCharged" min="0" step="0.01" inputmode="decimal" placeholder="0.00" />
            </span>
          </p>
          <p class="tw-rc__field">
            <label for="twDays">Days it sat in the lot</label>
            <input type="number" id="twDays" min="0" max="365" step="1" inputmode="numeric" placeholder="0" />
          </p>
          <p class="tw-rc__field">
            <label for="twSize">The vehicle</label>
            <select id="twSize">
              <option value="100">Car or light truck, 8,000 lb or under</option>
              <option value="275">Heavy, over 8,000 lb</option>
            </select>
          </p>
        </div>
        <div class="tw-rc__out" id="twRcOut" role="status" aria-live="polite">
          <p class="tw-rc__verdict" id="twRcVerdict">Enter what you paid and the lawful ceiling appears here.</p>
          <p class="tw-rc__detail" id="twRcDetail"></p>
        </div>
        <p class="tw-rc__foot">
          This is the <strong>public-tow</strong> schedule — the one that applies when you didn’t agree to the
          tow. A tow you called for yourself is a private tow and has <em>no</em> published ceiling; what
          protects you there is the signed, itemized estimate they owe you <em>before</em> the tow begins.
          <span class="tw-cite ps-record">16 DCMR &sect;&sect; 408.1, 409.1</span>
        </p>
      </div>

      <p class="tw-note">
        A heavy vehicle — over 8,000 lb — is capped at $275 instead. That larger figure circulates widely as
        “the DC tow fee.” For an ordinary car it is <span class="ps-mark-und">not the number</span>.
      </p>
      <p class="tw-note">
        Charging above the schedule for a public tow is itself prohibited, and the infraction schedule
        treats it as Class 1. <span class="tw-cite ps-record">16 DCMR &sect;&sect; 410.12, 3304.1(l)</span>
      </p>
    </div>
  </section>

  <!-- §03 THE DUTIES -->
  <section class="ips-sec" id="duties">
    <div class="ps-container">
      <div class="ips-sec-head">
        <span class="ps-record ps-record--red">&sect; 04</span>
        <h2 class="ips-sec-title">What they owe you</h2>
        <span class="ips-sec-rule"></span>
      </div>

      <p class="ips-lede">
        Every line below is generated from the regulation itself. Where the District’s infraction schedule
        grades a violation, the class is shown — <strong>Class 1 is the most serious</strong>.
      </p>

      {byGroup.map((g) => (
        <div class="tw-group">
          <h3 class="tw-group__h">{g.title}</h3>
          <ul class="tw-duties">
            {g.items.map((d) => (
              <li class="tw-duty">
                <p class="tw-duty__text">{d.plain}</p>
                <p class="tw-duty__meta ps-record">
                  <span class="tw-cite">{d.citation}</span>
                  {d.infractionClass && (
                    <span class={`tw-class tw-class--${d.infractionClass.replace(/\s+/g, '').toLowerCase()}`}>
                      {d.infractionClass} infraction
                      {d.infractionClassVia && <span class="tw-class__via"> (scheduled under {d.infractionClassVia})</span>}
                    </span>
                  )}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- §05 GETTING IT BACK -->
  <section class="ips-sec" id="getting-it-back">
    <div class="ps-container">
      <div class="ips-sec-head">
        <span class="ps-record ps-record--red">&sect; 05</span>
        <h2 class="ips-sec-title">Getting it back</h2>
        <span class="ips-sec-rule"></span>
      </div>

      <p class="ips-lede">
        This is where the two kinds of tow stop behaving the same way. <strong>Who took it decides
        where it is, what you pay, and what they owe you.</strong>
      </p>

      <div class="tw-fork">
        <div class="tw-fork__col">
          <h3 class="tw-fork__h">The District towed it</h3>
          <p class="tw-fork__when ps-record">Unpaid tickets, a snow emergency, illegal parking</p>
          <dl class="tw-dl">
            {districtLot.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
          </dl>
          <table class="tw-caps tw-caps--tight">
            <caption class="ps-record">DC DMV published fees</caption>
            <tbody>
              {districtFees.map(([k, v]) => (
                <tr><th scope="row">{k}</th><td class="tw-caps__num"><strong>{v}</strong></td></tr>
              ))}
            </tbody>
          </table>
          <p class="tw-note">
            These are the same figures as the regulation’s public-tow schedule.
            <span class="tw-cite ps-record">16 DCMR &sect; 408.1</span>
          </p>
        </div>

        <div class="tw-fork__col">
          <h3 class="tw-fork__h">A private lot towed it</h3>
          <p class="tw-fork__when ps-record">An apartment lot, a retail lot, a space you were parked in</p>
          <ul class="tw-duties">
            {privateLot.map(([k, v, cite]) => (
              <li class="tw-duty">
                <p class="tw-duty__text"><strong>{k}.</strong> {v}</p>
                <p class="tw-duty__meta ps-record"><span class="tw-cite">{cite}</span></p>
              </li>
            ))}
          </ul>
          <p class="tw-note">
            And the question from &sect; 02 still applies: <strong>was there a citation?</strong> If
            not, they should not have taken it at all.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- §04 WHAT TO DO -->
  <section class="ips-sec" id="what-to-do">
    <div class="ps-container">
      <div class="ips-sec-head">
        <span class="ps-record ps-record--red">&sect; 06</span>
        <h2 class="ips-sec-title">What to do now</h2>
        <span class="ips-sec-rule"></span>
      </div>

      <ol class="tw-first">
        <li><strong>Photograph the truck</strong> before it leaves — both cab doors, both sides. The name, address and phone have to be there, and so does the truck’s own ID number.</li>
        <li><strong>Ask for the towing control number</strong> when you collect the car. They have to give it to you. If there isn’t one, that is the answer to question two.</li>
        <li><strong>Ask what citation authorized the tow</strong>, and who requested it. The company had to report both to DPW before towing.</li>
        <li><strong>Ask to inspect the car before you pay.</strong> Refusing that is a violation in itself.</li>
        <li><strong>Get the itemized receipt.</strong> They cannot refuse it, and they have to accept a card — cash-only is not lawful.</li>
      </ol>

      <div class="tw-routes">
        {routes.map((r) => (
          <div class="tw-route">
            <h3 class="tw-route__who">{r.who}</h3>
            <p class="tw-route__what">{r.what}</p>
            <p class="tw-route__how ps-record">{r.how}</p>
            <p class="tw-cite ps-record">{r.cite}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- METHOD -->
  <section class="ips-sec" id="method">
    <div class="ps-container">
      <div class="ips-sec-head">
        <span class="ps-record ps-record--red">&sect; 07</span>
        <h2 class="ips-sec-title">How this page knows</h2>
        <span class="ips-sec-rule"></span>
      </div>
      <div class="dc-sources">
        <p>
          The duties above are not transcribed by hand. They are generated from
          <strong>{duties.chapter}</strong>, and each one is bound to a verbatim phrase that has to still
          appear in the section it cites — if the District amends the chapter, this page fails to build
          rather than telling you something that stopped being true.
        </p>
        <p>
          The chapter’s currency was checked against the District’s own register of rulemakings. The
          prohibition on towing from private property without a citation has one rulemaking on record and
          has never been amended.
        </p>
        <p class="ps-record tw-asof">
          Generated from the regulation on {duties.nodeGeneratedAt?.slice(0, 10) ?? 'the date shown above'} &middot;
          {' '}{duties.duties.length} duties &middot; sources: 16 DCMR chapter 4, D.C. Official Code
        </p>
        <p>
          <strong>This is not legal advice</strong>, and it does not tell you whether your own tow was lawful —
          only what the rule requires. If a tow company disagrees with something here, the regulation is
          public and the citations are on every line.
        </p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .tw-def {
    border-left: 3px solid var(--ps-accent);
    padding: 1rem 0 1rem 1.1rem;
    margin: 0 0 2rem;
    max-width: 60ch;
  }
  .tw-def__label { display: block; margin-bottom: .4rem; }
  .tw-cite {
    font-size: .78rem;
    color: var(--ps-ink-soft);
    letter-spacing: .06em;
  }
  .tw-def .tw-cite { display: block; margin-top: .5rem; }

  .tw-tests { list-style: none; margin: 0 0 1.6rem; padding: 0; }
  .tw-test {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 0 1rem;
    padding: 1.2rem 0;
    border-top: 1px solid var(--ps-line);
    max-width: 68ch;
  }
  .tw-test__n { font-size: 1.4rem; line-height: 1.1; margin: 0; }
  .tw-test__q {
    font-family: var(--ps-font-display);
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 .5rem;
    letter-spacing: -.01em;
  }
  .tw-test__text, .tw-test__edge { margin: 0 0 .5rem; }
  .tw-test__edge { color: var(--ps-ink); }

  .tw-caps {
    border-collapse: collapse;
    width: 100%;
    max-width: 46rem;
    margin: 1.2rem 0;
  }
  .tw-caps caption { text-align: left; padding-bottom: .6rem; color: var(--ps-ink-soft); }
  .tw-caps th, .tw-caps td {
    border-top: 1px solid var(--ps-line);
    padding: .7rem .6rem;
    text-align: left;
    vertical-align: top;
  }
  .tw-caps thead th { border-top: 0; border-bottom: 2px solid var(--ps-ink); font-size: .82rem; }
  .tw-caps__num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .tw-note { max-width: 62ch; color: var(--ps-ink-soft); }
  .tw-note .tw-cite { display: inline; }

  .tw-group { margin: 2rem 0 0; }
  .tw-group__h {
    font-family: var(--ps-font-display);
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 .2rem;
    padding-bottom: .4rem;
    border-bottom: 2px solid var(--ps-ink);
    max-width: 68ch;
  }
  .tw-duties { list-style: none; margin: 0; padding: 0; max-width: 68ch; }
  .tw-duty { padding: .9rem 0; border-bottom: 1px solid var(--ps-line); }
  .tw-duty__text { margin: 0 0 .35rem; }
  .tw-duty__meta { margin: 0; display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: baseline; }
  .tw-class {
    font-size: .74rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: .12rem .4rem;
    border: 1px solid var(--ps-line);
    border-radius: var(--ps-radius);
    color: var(--ps-ink-soft);
  }
  /* Class 1 is the most serious tier — marked, but the word "Class 1" carries the
     meaning on its own, so nothing here depends on seeing the color. */
  .tw-class--class1 { color: var(--ps-accent-text); border-color: var(--ps-accent); }
  .tw-class__via { text-transform: none; letter-spacing: .02em; }

  .tw-first { max-width: 66ch; }
  .tw-first li { margin-bottom: .6rem; }

  .tw-routes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.2rem;
    margin-top: 1.6rem;
  }
  .tw-route {
    border: 1px solid var(--ps-line);
    border-top: 3px solid var(--ps-accent);
    padding: 1rem;
    background: var(--ps-surface);
    border-radius: var(--ps-radius);
  }
  .tw-route__who {
    font-family: var(--ps-font-display);
    font-size: 1.08rem;
    font-weight: 600;
    margin: 0 0 .4rem;
  }
  .tw-route__what { margin: 0 0 .5rem; }
  .tw-route__how { margin: 0 0 .3rem; color: var(--ps-ink); }
  .tw-asof { color: var(--ps-ink-soft); }

  /* The one number a person needs before anything else. Given weight because at
     11pm the difference between "towed" and "stolen" is the whole decision. */
  .tw-call {
    border: 1px solid var(--ps-line);
    border-left: 3px solid var(--ps-accent);
    background: var(--ps-surface);
    padding: 1rem 1.1rem;
    margin: 1.2rem 0;
    max-width: 34rem;
    border-radius: var(--ps-radius);
  }
  .tw-call__label { margin: 0 0 .3rem; }
  .tw-call__num {
    font-family: var(--ps-font-display);
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 .5rem;
    letter-spacing: -.01em;
  }
  .tw-call__num a { color: var(--ps-accent-text); text-decoration: none; }
  .tw-call__num a:hover, .tw-call__num a:focus { text-decoration: underline; }
  .tw-call__note { margin: 0; color: var(--ps-ink-soft); }

  .tw-fork {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 2rem;
    margin-top: 1.4rem;
  }
  .tw-fork__h {
    font-family: var(--ps-font-display);
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 .2rem;
    padding-bottom: .4rem;
    border-bottom: 2px solid var(--ps-ink);
  }
  .tw-fork__when { margin: .4rem 0 .9rem; color: var(--ps-ink-soft); }
  .tw-dl { margin: 0 0 1rem; }
  .tw-dl dt { font-weight: 700; margin-top: .7rem; }
  .tw-dl dd { margin: .15rem 0 0; }
  .tw-caps--tight { margin: .6rem 0; max-width: 22rem; }

  /* ---------------------------------------------------------------------
     THE TWO QUESTIONS, ANSWERABLE.  Radios, not buttons: arrow keys work,
     the group is announced as a group, and the answer survives a re-read of
     the question. The input sits invisibly ON TOP of its own chip, so the
     whole chip is the target and focus never scrolls somewhere else.
     --------------------------------------------------------------------- */
  .tw-ask { border: 0; padding: 0; margin: .3rem 0 .7rem; }
  .tw-ask__legend { padding: 0; margin-bottom: .35rem; color: var(--ps-ink-soft); }
  .tw-ask__opts { display: flex; flex-wrap: wrap; gap: .4rem; }
  .tw-ask__opt { position: relative; display: inline-flex; }
  .tw-ask__in {
    position: absolute; inset: 0; width: 100%; height: 100%;
    margin: 0; opacity: 0; cursor: pointer;
  }
  .tw-ask__lab {
    display: inline-block;
    font-family: var(--ps-font-record);
    font-size: .82rem; letter-spacing: .06em; text-transform: uppercase;
    padding: .5rem .85rem;
    min-height: 1.5rem; line-height: 1.5;
    border: 1px solid var(--ps-line);
    border-radius: var(--ps-radius);
    background: var(--ps-surface);
    color: var(--ps-ink);
    cursor: pointer;
  }
  .tw-ask__in:hover + .tw-ask__lab { border-color: var(--ps-ink-soft); }
  .tw-ask__in:focus-visible + .tw-ask__lab {
    outline: 3px solid var(--ps-accent); outline-offset: 2px;
  }
  /* Selection is carried by the FILL and by the radio's own checked state, which
     assistive tech reads directly. Color is reinforcement, never the only signal. */
  .tw-ask__in:checked + .tw-ask__lab {
    background: var(--ps-accent-fill);
    border-color: var(--ps-accent-fill);
    color: var(--ps-accent-fill-ink);
  }

  .tw-stand {
    background: var(--ps-mark);
    border-left: 3px solid var(--ps-accent);
    padding: 1rem 1.1rem;
    max-width: 68ch;
    border-radius: var(--ps-radius);
    margin: 1.4rem 0 1rem;
  }
  .tw-stand__label { margin: 0 0 .35rem; color: var(--ps-accent-text-mark); }
  .tw-stand__verdict {
    font-family: var(--ps-font-display);
    font-size: 1.3rem; font-weight: 600; line-height: 1.3;
    margin: 0;
  }
  .tw-stand__detail { margin: .5rem 0 0; }
  .tw-stand__detail:empty { display: none; }

  /* ---------------------------------------------------------------------
     RECEIPT CHECKER.  One comparison, on device. It reports the ceiling and
     the difference; it never says the tow was unlawful, because the schedule
     applies to public tows and this page cannot know which kind yours was.
     --------------------------------------------------------------------- */
  .tw-rc {
    border: 1px solid var(--ps-line);
    border-top: 3px solid var(--ps-accent);
    background: var(--ps-surface);
    border-radius: var(--ps-radius);
    padding: 1.1rem;
    margin: 1.6rem 0;
    max-width: 46rem;
  }
  .tw-rc__label { margin: 0 0 .8rem; color: var(--ps-accent-text); }
  .tw-rc__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: .9rem;
    margin: 0 0 1rem;
  }
  .tw-rc__field { margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .tw-rc__field label {
    font-family: var(--ps-font-record);
    font-size: .78rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--ps-ink-soft);
  }
  .tw-rc__field input, .tw-rc__field select {
    font: inherit;
    font-variant-numeric: tabular-nums;
    padding: .5rem .55rem;
    min-height: 2.5rem;
    border: 1px solid var(--ps-line);
    border-radius: var(--ps-radius);
    background: var(--ps-paper);
    color: var(--ps-ink);
    width: 100%;
  }
  .tw-rc__field input:focus-visible, .tw-rc__field select:focus-visible {
    outline: 3px solid var(--ps-accent); outline-offset: 2px;
  }
  .tw-rc__money { position: relative; display: block; }
  .tw-rc__cur {
    position: absolute; left: .55rem; top: 50%; transform: translateY(-50%);
    color: var(--ps-ink-soft); font-family: var(--ps-font-record);
  }
  .tw-rc__money input { padding-left: 1.5rem; }
  .tw-rc__out {
    border-top: 1px solid var(--ps-line);
    padding-top: .9rem;
  }
  .tw-rc__verdict {
    font-family: var(--ps-font-display);
    font-size: 1.25rem; font-weight: 600; line-height: 1.3;
    margin: 0;
  }
  .tw-rc__verdict--over { color: var(--ps-accent-text); }
  .tw-rc__detail { margin: .45rem 0 0; }
  .tw-rc__detail:empty { display: none; }
  .tw-rc__foot { margin: 1rem 0 0; color: var(--ps-ink-soft); font-size: .96rem; }
  .tw-rc__foot .tw-cite { display: block; margin-top: .4rem; }

  /* ---------------------------------------------------------------------
     THE ANCHOR.  A receipt stub: the flag's two bars at the head, mono
     tabular figures, a torn lower edge. Decorative and aria-hidden — every
     figure on it is stated in full in section 03.
     --------------------------------------------------------------------- */
  .tw-stub {
    background: var(--ps-surface-2);
    border: 1px solid var(--ps-line);
    border-bottom: 0;
    padding: 1rem 1.1rem 1.2rem;
    margin: 0 0 1.2rem;
    font-family: var(--ps-font-record);
    position: relative;
  }
  /* the torn edge, drawn rather than imaged so it themes with everything else */
  .tw-stub::after {
    content: '';
    position: absolute; left: -1px; right: -1px; bottom: -9px; height: 10px;
    background:
      radial-gradient(circle at 5px 0, transparent 5px, var(--ps-line) 5px 5.8px, transparent 5.9px)
      repeat-x 0 0 / 10px 10px,
      radial-gradient(circle at 5px -1px, transparent 5px, var(--ps-surface-2) 5px) repeat-x 0 0 / 10px 10px;
  }
  .tw-stub__bars {
    display: block; height: 7px; margin-bottom: .7rem;
    background: linear-gradient(var(--ps-accent) 0 3px, transparent 3px 4px, var(--ps-accent) 4px 7px);
  }
  .tw-stub__h {
    font-family: var(--ps-font-display);
    font-size: 1.45rem; font-weight: 700; letter-spacing: -.01em;
    margin: 0;
  }
  .tw-stub__sub {
    margin: .1rem 0 .9rem;
    font-size: .72rem; letter-spacing: .12em; text-transform: uppercase;
    color: var(--ps-ink-soft);
  }
  .tw-stub__lines { margin: 0; }
  .tw-stub__line {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 1rem;
    padding: .3rem 0;
    border-bottom: 1px dotted var(--ps-line);
  }
  .tw-stub__line dt { font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; color: var(--ps-ink-soft); }
  .tw-stub__line dd { margin: 0; font-variant-numeric: tabular-nums; font-weight: 600; }
  .tw-stub__ask {
    margin: .9rem 0 0;
    font-size: .78rem; letter-spacing: .1em; text-transform: uppercase;
    color: var(--ps-ink-soft);
  }
  .tw-stub__ans {
    margin: .15rem 0 0;
    font-family: var(--ps-font-display);
    font-size: 1.5rem; font-weight: 700; letter-spacing: -.01em;
    color: var(--ps-accent-text);
  }

  @media (max-width: 40rem) {
    .tw-test { grid-template-columns: 1fr; gap: .3rem; }
    .tw-caps { font-size: .95rem; }
  }
</style>

<script>
  // ---------------------------------------------------------------------------
  // Everything here runs in the reader's browser and nothing is sent anywhere.
  // No storage either: a towing receipt is a document about a person, and the
  // page promises it does not keep anything. Reload and it is gone.
  //
  // THE RULE THIS CODE OBEYS: the page states what the regulation required. It
  // never returns a finding about the reader's own tow. Every verdict below is
  // written about the REQUIREMENT, and every "no" path says the storage clock
  // keeps running -- because telling someone they may have been wronged, without
  // that sentence, is what turns this page into a $20-a-day cost.
  // ---------------------------------------------------------------------------

  // --- Section 02: the two questions ---------------------------------------
  const twRadios = Array.from(document.querySelectorAll('.tw-ask__in'));
  const twVerdict = document.getElementById('twVerdict');
  const twDetail = document.getElementById('twDetail');

  function answerOf(q) {
    const hit = twRadios.find((r) => r.dataset.q === q && r.checked);
    return hit ? hit.value : null;
  }

  function twUpdate() {
    const ticket = answerOf('ticket');
    const control = answerOf('control');

    if (!ticket || !control) {
      twVerdict.textContent = 'Answer both and your position appears here. Nothing you tap leaves this page.';
      twDetail.textContent = '';
      return;
    }

    const answers = [ticket, control];
    const noes = answers.filter((a) => a === 'no').length;
    const unknowns = answers.filter((a) => a === 'unk').length;

    if (noes > 0) {
      twVerdict.textContent = noes === 2
        ? 'Neither requirement was met.'
        : 'One of the two requirements was not met.';
      twDetail.textContent =
        'On what you have told this page, the tow did not meet what 16 DCMR chapter 4 requires, and each '
        + 'failure is a Class 1 infraction \u2014 the same tier as towing without a license. That is a matter for '
        + 'DLCP or a court to decide, not for this page. Collect the car first: storage runs at $20 a day '
        + 'and a dispute does not stop that clock. Keep the itemized receipt, then use section 06.';
      return;
    }

    if (unknowns > 0) {
      twVerdict.textContent = unknowns === 2
        ? 'You are entitled to know both of these.'
        : 'You are entitled to know that one.';
      twDetail.textContent =
        'Not knowing is not the same as it being fine. When the lot releases your car it has to hand you the '
        + 'towing control number and the legal authority for the removal, in writing, along with an itemized '
        + 'statement, a receipt and a copy of the Owner\u2019s Bill of Rights (16 DCMR \u00a7 408.9). Ask for them in '
        + 'those words and write down what you are told. If they refuse, that refusal is itself a violation.';
      return;
    }

    twVerdict.textContent = 'Both requirements appear to have been met.';
    twDetail.textContent =
      'That covers whether the tow could be ordered at all. It says nothing about the price or the '
      + 'paperwork \u2014 the ceiling in section 03 and the duties in section 04 still apply, and those are where '
      + 'most of the money goes wrong.';
  }

  twRadios.forEach((r) => r.addEventListener('change', twUpdate));

  // --- Section 03: the receipt checker --------------------------------------
  const rcCharged = document.getElementById('twCharged');
  const rcDays = document.getElementById('twDays');
  const rcSize = document.getElementById('twSize');
  const rcVerdict = document.getElementById('twRcVerdict');
  const rcDetail = document.getElementById('twRcDetail');

  const STORAGE_PER_DAY = 20;   // 16 DCMR s 408.1, per 24 hours or any part of one
  const money = (n) => '$' + n.toLocaleString('en-US', {
    minimumFractionDigits: 2, maximumFractionDigits: 2,
  });

  function rcUpdate() {
    const charged = parseFloat(rcCharged.value);
    // s 408.1 charges storage per 24 hours OR ANY PART OF ONE, so a partial
    // period rounds UP. Flooring it would understate the ceiling, which would
    // overstate the overcharge -- an error in the reader's favor, and this page
    // understates money rather than overstating it.
    const days = Math.max(0, Math.ceil(parseFloat(rcDays.value) || 0));
    const base = parseFloat(rcSize.value);
    const ceiling = base + (STORAGE_PER_DAY * days);
    const storage = STORAGE_PER_DAY * days;

    const basis = 'That is ' + money(base) + ' for the tow'
      + (days > 0
          ? ' plus ' + money(storage) + ' storage, at $20 for each 24 hours or part of one, for '
            + days + (days === 1 ? ' day' : ' days') + '. '
          : ', with no storage. ');

    rcVerdict.classList.remove('tw-rc__verdict--over');

    if (!Number.isFinite(charged) || charged < 0) {
      rcVerdict.textContent = 'The published ceiling is ' + money(ceiling) + '.';
      rcDetail.textContent = basis + 'Enter what you were charged to compare it.';
      return;
    }

    if (charged > ceiling) {
      const over = charged - ceiling;
      rcVerdict.classList.add('tw-rc__verdict--over');
      rcVerdict.textContent = money(charged) + ' is ' + money(over) + ' above the ' + money(ceiling) + ' ceiling.';
      rcDetail.textContent = basis
        + 'Charging more than the Director\u2019s schedule allows for a public tow is prohibited outright, and the '
        + 'infraction schedule treats it as Class 1 (16 DCMR \u00a7\u00a7 410.12, 3304.1(l)). Whether yours was a public '
        + 'tow is the question in section 02. Storage keeps accruing while a dispute does not stop it, so the '
        + 'usual order is to pay, collect the car, and take the itemized receipt to DLCP.';
      return;
    }

    rcVerdict.textContent = money(charged) + ' is at or under the ' + money(ceiling) + ' ceiling.';
    rcDetail.textContent = basis
      + 'The total is within the schedule. That is only the price \u2014 a tow can be correctly priced and still '
      + 'have been ordered without the citation and the control number section 02 asks about.';
  }

  [rcCharged, rcDays, rcSize].forEach((el) => {
    el.addEventListener('input', rcUpdate);
    el.addEventListener('change', rcUpdate);
  });
</script>
