  }
  .ips-lead__tel:hover, .ips-lead__tel:focus-visible { text-decoration: underline; }
  .ips-lead__first-n { display: block; color: var(--ps-ink-soft); font-size: .96rem; }

  /* §06, split by moment. The scene column is urgent; the counter column is not,
     and mixing them is what made the whole list read as things to do tonight. */
  .tw-when {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 2rem;
    margin-top: 1.4rem;
  }
  .tw-when__h {
    font-family: var(--ps-font-display);
    font-size: 1.3rem; font-weight: 600;
    margin: 0 0 .2rem;
    padding-bottom: .4rem;
    border-bottom: 2px solid var(--ps-ink);
  }
  .tw-when__sub { margin: .4rem 0 .9rem; color: var(--ps-ink-soft); }
  .tw-when .tw-first li .tw-cite { display: block; margin-top: .2rem; }
  .tw-safety {
    border-left: 3px solid var(--ps-accent);
    padding: .1rem 0 .1rem 1rem;
    margin: 1rem 0 0;
    color: var(--ps-ink);
  }

  /* ---------------------------------------------------------------------
     THE TWO QUESTIONS, ANSWERABLE.  Radios, not buttons: arrow keys work,
     the group is announced as a group, and the answer survives a re-read of
     the question. The input sits invisibly ON TOP of its own chip, so the
     whole chip is the target and focus never scrolls somewhere else.
     --------------------------------------------------------------------- */
  .tw-ask { border: 0; padding: 0; margin: .3rem 0 .7rem; }
  .tw-ask__legend { padding: 0; margin-bottom: .35rem; color: var(--ps-ink-soft); }
  .tw-ask__opts { display: flex; flex-wrap: wrap; gap: .4rem; }
  .tw-ask__opt { position: relative; display: inline-flex; }
  .tw-ask__in {
    position: absolute; inset: 0; width: 100%; height: 100%;
    margin: 0; opacity: 0; cursor: pointer;
  }
  .tw-ask__lab {
    display: inline-block;
    font-family: var(--ps-font-record);
    font-size: .82rem; letter-spacing: .06em; text-transform: uppercase;
    padding: .5rem .85rem;
    min-height: 1.5rem; line-height: 1.5;
    border: 1px solid var(--ps-line);
    border-radius: var(--ps-radius);
    background: var(--ps-surface);
    color: var(--ps-ink);
    cursor: pointer;
  }
  .tw-ask__in:hover + .tw-ask__lab { border-color: var(--ps-ink-soft); }
  .tw-ask__in:focus-visible + .tw-ask__lab {
    outline: 3px solid var(--ps-accent); outline-offset: 2px;
  }
  /* Selection is carried by the FILL and by the radio's own checked state, which
     assistive tech reads directly. Color is reinforcement, never the only signal. */
  .tw-ask__in:checked + .tw-ask__lab {
    background: var(--ps-accent-fill);
    border-color: var(--ps-accent-fill);
    color: var(--ps-accent-fill-ink);
  }

  .tw-stand {
    background: var(--ps-mark);
    border-left: 3px solid var(--ps-accent);
    padding: 1rem 1.1rem;
    max-width: 68ch;
    border-radius: var(--ps-radius);
    margin: 1.4rem 0 1rem;
  }
  .tw-stand__label { margin: 0 0 .35rem; color: var(--ps-accent-text-mark); }
  .tw-stand__verdict {
    font-family: var(--ps-font-display);
    font-size: 1.3rem; font-weight: 600; line-height: 1.3;
    margin: 0;
  }
  .tw-stand__detail { margin: .5rem 0 0; }
  .tw-stand__detail:empty { display: none; }

  /* ---------------------------------------------------------------------
     RECEIPT CHECKER.  One comparison, on device. It reports the ceiling and
     the difference; it never says the tow was unlawful, because the schedule
     applies to public tows and this page cannot know which kind yours was.
     --------------------------------------------------------------------- */
  .tw-rc {
    border: 1px solid var(--ps-line);
    border-top: 3px solid var(--ps-accent);
    background: var(--ps-surface);
    border-radius: var(--ps-radius);
    padding: 1.1rem;
    margin: 1.6rem 0;
    max-width: 46rem;
  }
  .tw-rc__label { margin: 0 0 .8rem; color: var(--ps-accent-text); }
  .tw-rc__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: .9rem;
    margin: 0 0 1rem;
  }
  .tw-rc__field { margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .tw-rc__field label {
    font-family: var(--ps-font-record);
    font-size: .78rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--ps-ink-soft);
  }
  .tw-rc__field input, .tw-rc__field select {
    font: inherit;
    font-variant-numeric: tabular-nums;
    padding: .5rem .55rem;
    min-height: 2.5rem;
    border: 1px solid var(--ps-line);
    border-radius: var(--ps-radius);
    background: var(--ps-paper);
    color: var(--ps-ink);
    width: 100%;
  }
  .tw-rc__field input:focus-visible, .tw-rc__field select:focus-visible {
    outline: 3px solid var(--ps-accent); outline-offset: 2px;
  }
  .tw-rc__money { position: relative; display: block; }
  .tw-rc__cur {
    position: absolute; left: .55rem; top: 50%; transform: translateY(-50%);
    color: var(--ps-ink-soft); font-family: var(--ps-font-record);
  }
  .tw-rc__money input { padding-left: 1.5rem; }
  .tw-rc__out {
    border-top: 1px solid var(--ps-line);
    padding-top: .9rem;
  }
  .tw-rc__verdict {
    font-family: var(--ps-font-display);
    font-size: 1.25rem; font-weight: 600; line-height: 1.3;
    margin: 0;
  }
  .tw-rc__verdict--over { color: var(--ps-accent-text); }
  .tw-rc__detail { margin: .45rem 0 0; }
  .tw-rc__detail:empty { display: none; }
  .tw-rc__foot { margin: 1rem 0 0; color: var(--ps-ink-soft); font-size: .96rem; }
  .tw-rc__foot .tw-cite { display: block; margin-top: .4rem; }

  /* ---------------------------------------------------------------------
     THE ANCHOR.  A receipt stub: the flag's two bars at the head, mono
     tabular figures, a torn lower edge. Decorative and aria-hidden — every
     figure on it is stated in full in section 03.
     --------------------------------------------------------------------- */
  .tw-stub {
    background: var(--ps-surface-2);
    border: 1px solid var(--ps-line);
    border-bottom: 0;
    padding: 1rem 1.1rem 1.2rem;
    margin: 0 0 1.2rem;
    font-family: var(--ps-font-record);
    position: relative;
  }
  /* the torn edge, drawn rather than imaged so it themes with everything else */
  .tw-stub::after {
    content: '';
    position: absolute; left: -1px; right: -1px; bottom: -9px; height: 10px;
    background:
      radial-gradient(circle at 5px 0, transparent 5px, var(--ps-line) 5px 5.8px, transparent 5.9px)
      repeat-x 0 0 / 10px 10px,
      radial-gradient(circle at 5px -1px, transparent 5px, var(--ps-surface-2) 5px) repeat-x 0 0 / 10px 10px;
  }
  .tw-stub__bars {
    display: block; height: 7px; margin-bottom: .7rem;
    background: linear-gradient(var(--ps-accent) 0 3px, transparent 3px 4px, var(--ps-accent) 4px 7px);
  }
  .tw-stub__h {
    font-family: var(--ps-font-display);
    font-size: 1.45rem; font-weight: 700; letter-spacing: -.01em;
    margin: 0;
  }
  .tw-stub__sub {
    margin: .1rem 0 .9rem;
    font-size: .72rem; letter-spacing: .12em; text-transform: uppercase;
    color: var(--ps-ink-soft);
  }
  .tw-stub__lines { margin: 0; }
  .tw-stub__line {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 1rem;
    padding: .3rem 0;
    border-bottom: 1px dotted var(--ps-line);
  }
  .tw-stub__line dt { font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; color: var(--ps-ink-soft); }
  .tw-stub__line dd { margin: 0; font-variant-numeric: tabular-nums; font-weight: 600; }
  .tw-stub__ask {
    margin: .9rem 0 0;
    font-size: .78rem; letter-spacing: .1em; text-transform: uppercase;
    color: var(--ps-ink-soft);
  }
  .tw-stub__ans {
    margin: .15rem 0 0;
    font-family: var(--ps-font-display);
    font-size: 1.5rem; font-weight: 700; letter-spacing: -.01em;
    color: var(--ps-accent-text);
  }

  /* ---------------------------------------------------------------------
     THE COMPLAINT PACKET.  Assembled on device from what the reader already
     answered, plus the four things only they know. Editable on purpose: it is
     their complaint, and it reads better in their words than in ours.
     --------------------------------------------------------------------- */
  .tw-pk {
    border: 1px solid var(--ps-line);
    border-top: 3px solid var(--ps-accent);
    background: var(--ps-surface);
    border-radius: var(--ps-radius);
    padding: 1.1rem;
    margin: 1.6rem 0;
  }
  .tw-pk__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: .9rem;
    margin: 0 0 1rem;
  }
  .tw-pk__field { margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .tw-pk__field label {
    font-family: var(--ps-font-record);
    font-size: .78rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--ps-ink-soft);
  }
  .tw-pk__field input, .tw-pk__field select {
    font: inherit;
    padding: .5rem .55rem;
    min-height: 2.5rem;
    border: 1px solid var(--ps-line);
    border-radius: var(--ps-radius);
    background: var(--ps-paper);
    color: var(--ps-ink);
    width: 100%;
  }
  .tw-pk__field input:focus-visible, .tw-pk__field select:focus-visible,
  .tw-pk__out:focus-visible {
    outline: 3px solid var(--ps-accent); outline-offset: 2px;
  }
  .tw-pk__scout { margin: 0 0 1.2rem; color: var(--ps-ink-soft); font-size: .96rem; max-width: 66ch; }
  .tw-pk__scout .tw-cite { display: block; margin-top: .3rem; }

  .tw-pk__actions { margin: 0 0 .6rem; display: flex; flex-wrap: wrap; gap: .5rem; }
  .tw-pk__btn {
    font-family: var(--ps-font-record);
    font-size: .82rem; letter-spacing: .08em; text-transform: uppercase;
    padding: .6rem 1rem;
    min-height: 2.6rem;
    border: 1px solid var(--ps-ink);
    border-radius: var(--ps-radius);
    background: var(--ps-surface);
    color: var(--ps-ink);
    cursor: pointer;
  }
  .tw-pk__btn:hover { background: var(--ps-surface-2); }
  .tw-pk__btn:focus-visible { outline: 3px solid var(--ps-accent); outline-offset: 2px; }
  /* Red as a verb: the one control that does the thing this section exists for. */
  .tw-pk__btn--go {
    background: var(--ps-accent-fill);
    border-color: var(--ps-accent-fill);
    color: var(--ps-accent-fill-ink);
  }
  .tw-pk__btn--go:hover { background: var(--ps-accent-fill-hover); border-color: var(--ps-accent-fill-hover); }
  .tw-pk__status { margin: 0 0 .6rem; color: var(--ps-ink-soft); }
  .tw-pk__status:empty { display: none; }

  .tw-pk__outlabel {
    display: block;
    font-family: var(--ps-font-record);
    font-size: .78rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--ps-ink-soft);
    margin-bottom: .3rem;
  }
  .tw-pk__outlabel:has(+ .tw-pk__out[hidden]) { display: none; }
  .tw-pk__out {
    width: 100%;
    font-family: var(--ps-font-record);
    font-size: .88rem;
    line-height: 1.5;
    padding: .9rem;
    border: 1px solid var(--ps-line);
    border-radius: var(--ps-radius);
    background: var(--ps-paper);
    color: var(--ps-ink);
    resize: vertical;
    white-space: pre;
    overflow-wrap: normal;
    overflow-x: auto;
  }

  /* Print gives them the complaint alone, not the website around it. An angry
     person wants a sheet of paper to hand across a counter. */
  @media print {
    body * { visibility: hidden; }
    #packet, #packet * { visibility: visible; }
    #packet { position: absolute; inset: 0; padding: 0; }
    .tw-pk__row, .tw-pk__actions, .tw-pk__scout, .tw-pk__status,
    .ips-sec-head, .ips-lede, .tw-note, .tw-pk__outlabel { display: none !important; }
    .tw-pk { border: 0; padding: 0; background: none; }
    .tw-pk__out {
      border: 0; padding: 0; background: none; color: #000;
      height: auto; min-height: 100vh; font-size: 10.5pt; resize: none;
    }
  }

  @media (max-width: 40rem) {
    .tw-test { grid-template-columns: 1fr; gap: .3rem; }
    .tw-caps { font-size: .95rem; }
  }
</style>

<script>
  // ---------------------------------------------------------------------------
  // Everything here runs in the reader's browser and nothing is sent anywhere.
  // No storage either: a towing receipt is a document about a person, and the
  // page promises it does not keep anything. Reload and it is gone.
  //
  // THE RULE THIS CODE OBEYS: the page states what the regulation required. It
  // never returns a finding about the reader's own tow. Every verdict below is
  // written about the REQUIREMENT, and every "no" path says the storage clock
  // keeps running -- because telling someone they may have been wronged, without
  // that sentence, is what turns this page into a $20-a-day cost.
  // ---------------------------------------------------------------------------

  // --- Section 02: the two questions ---------------------------------------
  const twRadios = Array.from(document.querySelectorAll('.tw-ask__in'));
  const twVerdict = document.getElementById('twVerdict');
  const twDetail = document.getElementById('twDetail');

  function answerOf(q) {
    const hit = twRadios.find((r) => r.dataset.q === q && r.checked);
    return hit ? hit.value : null;
  }

  function twUpdate() {
    const ticket = answerOf('ticket');
    const control = answerOf('control');

    if (!ticket || !control) {
      twVerdict.textContent = 'Answer both and your position appears here. Nothing you tap leaves this page.';
      twDetail.textContent = '';
      return;
    }

    const answers = [ticket, control];
    const noes = answers.filter((a) => a === 'no').length;
    const unknowns = answers.filter((a) => a === 'unk').length;

    if (noes > 0) {
      twVerdict.textContent = noes === 2
        ? 'Neither requirement was met.'
        : 'One of the two requirements was not met.';
      twDetail.textContent =
        'On what you have told this page, the tow did not meet what 16 DCMR chapter 4 requires, and each '
        + 'failure is a Class 1 infraction \u2014 the same tier as towing without a license. That is a matter for '
        + 'DLCP or a court to decide, not for this page. Collect the car first: storage runs at $20 a day '
        + 'and a dispute does not stop that clock. Keep the itemized receipt, then use section 06.';
      return;
    }

    if (unknowns > 0) {
      twVerdict.textContent = unknowns === 2
        ? 'You are entitled to know both of these.'
        : 'You are entitled to know that one.';
      twDetail.textContent =
        'Not knowing is not the same as it being fine. When the lot releases your car it has to hand you the '
        + 'towing control number and the legal authority for the removal, in writing, along with an itemized '
        + 'statement, a receipt and a copy of the Owner\u2019s Bill of Rights (16 DCMR \u00a7 408.9). Ask for them in '
        + 'those words and write down what you are told. If they refuse, that refusal is itself a violation.';
      return;
    }

    twVerdict.textContent = 'Both requirements appear to have been met.';
    twDetail.textContent =
      'That covers whether the tow could be ordered at all. It says nothing about the price or the '
      + 'paperwork \u2014 the ceiling in section 03 and the duties in section 04 still apply, and those are where '
      + 'most of the money goes wrong.';
  }

  twRadios.forEach((r) => r.addEventListener('change', twUpdate));

  // --- Section 03: the receipt checker --------------------------------------
  const rcCharged = document.getElementById('twCharged');
  const rcDays = document.getElementById('twDays');
  const rcSize = document.getElementById('twSize');
  const rcVerdict = document.getElementById('twRcVerdict');
  const rcDetail = document.getElementById('twRcDetail');

  // Read from the DOM, which got it from the generated projection, which parsed it
  // from 16 DCMR 408.1. Never a literal here: this number decides whether the page
  // tells someone they were overcharged.
  const rcData = document.querySelector('.tw-rc').dataset;
  const STORAGE_PER_DAY = Number(rcData.storagePerDay);
  if (!Number.isFinite(STORAGE_PER_DAY) || STORAGE_PER_DAY <= 0) {
    throw new Error('towing: storage rate missing from the projection — refusing to compute');
  }
  // § 408.1 allows two charges on TOP of tow and storage. The ceiling below does
  // not include them, because this page cannot know whether they applied -- so
  // the over-the-ceiling path has to say so. Leaving them out silently would
  // overstate an overcharge, which is the direction the standing lens forbids
  // and the same error as the day-rounding bug (Wave 3, D-2).
  const ROAD_SERVICE = Number(rcData.roadService);
  const MILEAGE = { 100: Number(rcData.mileageStandard), 275: Number(rcData.mileageHeavy) };
  const money = (n) => '$' + n.toLocaleString('en-US', {
    minimumFractionDigits: 2, maximumFractionDigits: 2,
  });

  function rcUpdate() {
    const charged = parseFloat(rcCharged.value);
    // s 408.1 charges storage per 24 hours OR ANY PART OF ONE, so a partial
    // period rounds UP. Flooring it would understate the ceiling, which would
    // overstate the overcharge -- an error in the reader's favor, and this page
    // understates money rather than overstating it.
    const days = Math.max(0, Math.ceil(parseFloat(rcDays.value) || 0));
    const base = parseFloat(rcSize.value);
    const ceiling = base + (STORAGE_PER_DAY * days);
    const storage = STORAGE_PER_DAY * days;

    const basis = 'That is ' + money(base) + ' for the tow'
      + (days > 0
          ? ' plus ' + money(storage) + ' storage, at $20 for each 24 hours or part of one, for '
            + days + (days === 1 ? ' day' : ' days') + '. '
          : ', with no storage. ');

    rcVerdict.classList.remove('tw-rc__verdict--over');

    if (!Number.isFinite(charged) || charged < 0) {
      rcVerdict.textContent = 'The published ceiling is ' + money(ceiling) + '.';
      rcDetail.textContent = basis + 'Enter what you were charged to compare it.';
      return;
    }

    if (charged > ceiling) {
      const over = charged - ceiling;
      rcVerdict.classList.add('tw-rc__verdict--over');
      rcVerdict.textContent = money(charged) + ' is ' + money(over) + ' above the ' + money(ceiling) + ' ceiling.';
      const mile = MILEAGE[base] || 0;
      rcDetail.textContent = basis
        + 'Charging more than the Director\u2019s schedule allows for a public tow is prohibited outright, and the '
        + 'infraction schedule treats it as Class 1 (16 DCMR \u00a7\u00a7 410.12, 3304.1(l)). Whether yours was a public '
        + 'tow is the question in section 02. '
        + 'Two lawful charges are NOT in that ceiling, so check the receipt for them before you rely on the '
        + 'difference: road service, up to $' + ROAD_SERVICE.toFixed(2) + ', if they jump-started it or changed a '
        + 'tire, and $' + mile.toFixed(2) + ' a mile beyond the District line if you asked them to take it out of '
        + 'the city. '
        + 'Storage keeps accruing while a dispute does not stop it, so the '
        + 'usual order is to pay, collect the car, and take the itemized receipt to DLCP.';
      return;
    }

    rcVerdict.textContent = money(charged) + ' is at or under the ' + money(ceiling) + ' ceiling.';
    rcDetail.textContent = basis
      + 'The total is within the schedule. That is only the price \u2014 a tow can be correctly priced and still '
      + 'have been ordered without the citation and the control number section 02 asks about.';
  }


  // --- Section 07: the complaint packet ------------------------------------
  //
  // COMPLAINT REGISTER, decided by Pippa 2026-09-08. Not a neutral record and
  // not a demand: it names the provisions it asks the regulator to look at, and
  // it stops there. The closing line is load-bearing -- the reader states what
  // they observed and what the rule says, and asserts no legal conclusion. That
  // is the project's standing lens surviving into a document that leaves here.
  //
  // A provision is listed ONLY where the reader's own answers put it at issue.
  // If nothing is at issue the packet says so and does not pretend otherwise:
  // a tool willing to tell you that you have a complaint has to be equally
  // willing to tell you that you do not.
  //
  // Company names are typed by the reader off their own receipt, stay in their
  // browser and are never shipped in this page's payload.

  const pk = {
    date: document.getElementById('pkDate'),
    from: document.getElementById('pkFrom'),
    co: document.getElementById('pkCo'),
    lot: document.getElementById('pkLot'),
    scout: document.getElementById('pkScout'),
    build: document.getElementById('pkBuild'),
    copy: document.getElementById('pkCopy'),
    print: document.getElementById('pkPrint'),
    out: document.getElementById('pkOut'),
    status: document.getElementById('pkStatus'),
  };

  const PROVISIONS = {
    '406.7': 'A vehicle may not be towed from private real property without the owner’s\n' +
             '                    consent unless a police officer or parking enforcement official issued\n' +
             '                    a citation, or a police officer directed the tow in an emergency.',
    '406.3': 'A towing control number must be obtained from DPW before the tow.',
    '408.9': 'On release, the lot must provide the towing control number, the legal\n' +
             '                    authority for the removal, an itemized statement, a receipt, and a copy\n' +
             '                    of the Owner’s Bill of Rights.',
    '408.1': 'Published maximum rates for a public tow.',
    '410.12': 'Charging more than the Director’s schedule permits for a public tow\n' +
              '                    is prohibited.',
    '410.1': 'Operating a towing business without a valid current license is unlawful.',
  };

  // 32 clears the longest label, 'Citation issued before the tow?', which overran a 30 pad
  // and silently dropped its dot leader.
  const pad = (label, value) => '  ' + (label + ' ').padEnd(32, '.') + ' ' + value;
  const fmtDate = (v) => {
    if (!v) return '[not given]';
    const d = new Date(v + 'T12:00:00');
    return isNaN(d) ? v : d.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });
  };
  const said = (v) => (v === 'yes' ? 'YES' : v === 'no' ? 'NO' : v === 'unk' ? 'I WAS NOT TOLD' : 'NOT ANSWERED');

  function buildPacket() {
    const ticket = answerOf('ticket');
    const control = answerOf('control');
    const charged = parseFloat(rcCharged.value);
    const days = Math.max(0, Math.ceil(parseFloat(rcDays.value) || 0));
    const base = parseFloat(rcSize.value);
    const ceiling = base + (STORAGE_PER_DAY * days);
    const overcharged = Number.isFinite(charged) && charged > ceiling;

    // Only what the reader's own answers put at issue.
    const cites = [];
    if (ticket === 'no' || ticket === 'unk') cites.push('406.7');
    if (control === 'no' || control === 'unk') { cites.push('406.3'); cites.push('408.9'); }
    if (overcharged) { cites.push('408.1'); cites.push('410.12'); }
    if (pk.scout.value === 'absent') cites.push('410.1');

    const L = [];
    L.push('TOWING COMPLAINT — PREPARED FROM MY OWN RECORDS');
    L.push('Prepared ' + new Date().toLocaleDateString('en-US',
      { day: 'numeric', month: 'long', year: 'numeric' }));
    L.push('');
    L.push('WHAT HAPPENED');
    L.push(pad('Date of tow', fmtDate(pk.date.value)));
    L.push(pad('Taken from', pk.from.value.trim() || '[not given]'));
    L.push(pad('Company on receipt', pk.co.value.trim() || '[not given]'));
    L.push(pad('Storage lot', pk.lot.value.trim() || '[not given]'));
    if (Number.isFinite(charged)) L.push(pad('Amount I paid', '$' + charged.toFixed(2)));
    if (days > 0) L.push(pad('Days held', String(days)));
    L.push('');
    L.push('WHAT I WAS ABLE TO ESTABLISH');
    L.push(pad('Citation issued before the tow?', said(ticket)));
    L.push(pad('Given a towing control number?', said(control)));
    L.push(pad('Listed as licensed on SCOUT?',
      pk.scout.value === 'listed' ? 'YES' : pk.scout.value === 'absent' ? 'I COULD NOT FIND IT'
        : 'I HAVE NOT CHECKED'));

    if (Number.isFinite(charged)) {
      L.push('');
      L.push('WHAT THE PUBLISHED SCHEDULE ALLOWS');
      L.push(pad(base === 275 ? 'Tow, over 8,000 lb' : 'Tow, car under 8,000 lb', '$' + base.toFixed(2)));
      if (days > 0) L.push(pad('Storage, ' + days + ' at $20', '$' + (STORAGE_PER_DAY * days).toFixed(2)));
      L.push(pad('Maximum for this tow', '$' + ceiling.toFixed(2)));
      L.push(pad('I was charged', '$' + charged.toFixed(2)));
      L.push(pad(overcharged ? 'Charged above the maximum by' : 'Within the maximum by',
        '$' + Math.abs(charged - ceiling).toFixed(2)));
      L.push('');
      L.push('  These maximums apply to a public tow, which under 16 DCMR § 499 means a tow');
      L.push('  carried out without the consent of the owner, expressly including tows from');
      L.push('  private real property.');
    }

    L.push('');
    if (cites.length) {
      L.push('PROVISIONS I AM ASKING DLCP TO LOOK AT');
      cites.forEach((c) => {
        L.push('  16 DCMR § ' + c.padEnd(7) + ' ' + PROVISIONS[c]);
      });
      L.push('');
      L.push('WHAT I AM ASKING FOR');
      L.push('  DLCP is required to investigate a complaint against a towing business');
      L.push('  (16 DCMR § 411.2) and may suspend or revoke a license (§ 411.4).');
      L.push('  I am asking for an investigation.');
    } else {
      L.push('WHERE THIS LEAVES ME');
      L.push('  On my own answers, nothing above puts a specific provision of 16 DCMR');
      L.push('  chapter 4 at issue. A citation was issued, I was given a control number,');
      L.push('  and the amount was within the published maximum. I am recording it here');
      L.push('  in case something further comes to light.');
    }

    L.push('');
    L.push('WHAT I HAVE');
    ['Photographs of the truck', 'The itemized receipt', 'The towing control number',
     'Photographs of where I was parked', 'The citation, if there was one'].forEach((x) => {
      L.push('  [ ] ' + x);
    });
    L.push('');
    L.push('I am stating what I observed and what the regulation says. I am not asserting');
    L.push('a legal conclusion about this tow.');
    return L.join('\n');
  }

  function showPacket() {
    pk.out.value = buildPacket();
    pk.out.hidden = false;
    pk.copy.hidden = false;
    pk.print.hidden = false;
    pk.status.textContent = 'Built. Edit it freely — it reads better in your own words.';
    pk.out.focus();
  }

  pk.build.addEventListener('click', () => {
    const already = !pk.out.hidden && pk.out.value.trim();
    if (already && !confirm('Rebuilding replaces anything you have edited. Continue?')) return;
    showPacket();
  });

  pk.copy.addEventListener('click', async () => {
    // Clipboard access is refused in plenty of ordinary contexts, so it always
    // falls back to selecting the text rather than failing silently.
    try {
      await navigator.clipboard.writeText(pk.out.value);
      pk.status.textContent = 'Copied to your clipboard.';
    } catch (e) {
      pk.out.select();
      pk.status.textContent = 'Your browser blocked the copy — the text is selected, so press '
        + (navigator.platform.indexOf('Mac') === 0 ? 'Cmd+C' : 'Ctrl+C') + '.';
    }
  });

  pk.print.addEventListener('click', () => window.print());

  // A built packet does NOT follow later edits to the answers above, because
  // regenerating would silently discard whatever the reader has written into it.
  // But going stale in silence is its own trap, so say so instead. Announced
  // through the same live region, so it is not a purely visual cue.
  function markStale() {
    if (pk.out.hidden) return;
    pk.status.textContent = 'Your answers above have changed. Rebuild to bring the complaint '
      + 'in line — that will replace anything you have edited.';
  }
  twRadios.forEach((r) => r.addEventListener('change', markStale));
  [rcCharged, rcDays, rcSize, pk.date, pk.from, pk.co, pk.lot, pk.scout]
    .forEach((el) => el.addEventListener('change', markStale));

  [rcCharged, rcDays, rcSize].forEach((el) => {
    el.addEventListener('input', rcUpdate);
    el.addEventListener('change', rcUpdate);
  });
</script>
