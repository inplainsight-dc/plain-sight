  "findings": [
    {
      "id": "V1-report-titles-do-not-match-contents",
      "severity": "high",
      "claim": "MOTA's two seat-level reports carry titles that describe each other's contents.",
      "counter_reading": "The report definitions are not published, so the swap is an inference from content. qid 304 could be some other filter (e.g. 'seats needing action this year') that happens to hold only current-year term ends. What is NOT an inference is that neither title describes what the export contains."
    },
    {
      "id": "V2-vacancy-counts-disagree",
      "severity": "high",
      "claim": "Two MOTA views published as 'in real time' give vacant-seat counts that differ by 16.2x, and one of them agrees with MOTA's body-level column while the other does not.",
      "counter_reading": "If V1 holds, these are two different populations and neither is wrong — qid 304 is a term-expiry view that happens to contain some vacant seats. The disagreement then belongs to the labels, not the data. Recorded either way, because both views are published as current vacancy information."
    },
    {
      "id": "V3-past-term-seats-not-labeled-holdover",
      "severity": "high",
      "claim": "44 Council-confirmed seats are past their term end in MOTA's own data, 25 of them shown as 'Active / filled seat' rather than 'Holdover member'. Only 5 seats in the whole view carry the holdover label.",
      "counter_reading": "'Term end' may be a stale field: a member reappointed to a new term whose row was never updated would look identical to a holdover. MOTA may also record the SEAT's term cycle rather than the incumbent's. Either reading means the published term end cannot be used to compute service length — which is itself the p5 finding."
    },
    {
      "id": "V4-seats-past-the-180-day-cap",
      "severity": "high",
      "claim": "5 Council-confirmed seats are more than 180 days past their term end as of the 2026-08-17 capture; 4 of them are shown as occupied.",
      "counter_reading": "(c) caps a PERSON's hold-over service, not a seat's vacancy: a seat listed vacant past term has no holdover to cap, and an occupied row is only a breach if the same person is still serving on the expired term — which the stale-field reading in V3 would explain away. This is recorded as exposure on the face of MOTA's own data, NOT as a finding that anyone has overstayed. It names no individual."
    },
    {
      "id": "V5-holdover-seats-approaching-the-cap",
      "severity": "medium",
      "claim": "4 of the 5 seats MOTA itself labels 'Holdover member' reach the 180-day cap within 60 days of the 2026-08-17 capture.",
      "counter_reading": "A cap date computed from a published term end inherits every doubt in V3 about that field. The dates are arithmetic on MOTA's numbers, not a legal conclusion."
    },
    {
      "id": "V6-vacancy-load-sits-mostly-outside-council-confirmation",
      "severity": "medium",
      "claim": "149 of 279 seats in the vacancy register (53%) are Executive Appointment — fillable by Mayor's Order with no Council action. 130 require Council action.",
      "counter_reading": "This split uses MOTA's own classification, which p4-t2 records as disputed for specific bodies (D1: three bodies the statute lists but MOTA calls Mayor's Order). Every disputed body moves seats from the left column to the right, so the Executive share is an upper bound on MOTA's own reading."
    },
    {
      "id": "V8-bodies-with-no-public-members-at-all",
      "severity": "medium",
      "claim": "4 bodies have every one of their public-member seats vacant — 25 seats between them, and no public members at all.",
      "counter_reading": "'Public Member Vacancies' counts only public members; a body may still have its DC-agency appointees seated and be able to meet. Several of these are advisory bodies whose enabling statute may not require a quorum of public members. Recorded as a state of the register, not as a claim that any body has stopped functioning."
    },
    {
      "id": "V7-alphabetical-export-has-no-key-column",
      "severity": "low",
      "claim": "The 'Alphabetical list of all boards and commissions' export (qid 57) is unusable as data: 174 rows of counts with no body-name column.",
      "counter_reading": "A Quickbase export quirk rather than a data problem; the same information is reachable from method-of-appointment, which is why nothing here depends on this view."
    }
  ],
  "cautions": [
    "MOTA holds ZERO agency heads. Every seat here is a board or commission seat, and every row in the term-end view is a 'Mayoral Appointee, Public Member'. Nothing in this file speaks to § 1-523.01(a) — the agency-head clock and the project's headline question.",
    "Three grains are in play (body, and two different seat populations). A count from one view must never be added to a count from another. Every figure here names its view.",
    "Durations are measured against the capture date, not today. A finding here describes 2026-08-17 and says nothing about the state of any seat since.",
