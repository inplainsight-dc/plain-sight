  .al-form__btn { font-family: var(--ps-font-record); font-size: 0.9rem; letter-spacing: 0.03em; padding: 0.72rem 1.2rem; min-height: 44px; border-radius: 6px; border: 1.5px solid var(--ps-accent-fill); background: var(--ps-accent-fill); color: var(--ps-accent-fill-ink); cursor: pointer; }
  .al-form__btn:hover { background: var(--ps-accent-fill-hover); border-color: var(--ps-accent-fill-hover); }
